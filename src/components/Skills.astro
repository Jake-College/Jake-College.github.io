---
import Skill from './Skill.astro';
const skills = [
    { name: "CSS3", logo: "/img/CSS3-logo.png", level: 3 },
    { name: "Figma", logo: "/img/Figma-logo.png", level: 2 },
    { name: "Python", logo: "/img/Python-logo.png", level: 3 },
    { name: "SQLite", logo: "/img/SQLite.jpg", level: 3 },
    { name: "Microsoft Excel", logo: "/img/Microsoft_Excel.png", level: 3 },
    { name: "JavaScript", logo: "/img/JavaScript-logo.png", level: 3 },
    { name: "HTML5", logo: "/img/HTML5-logo.png", level: 3 }
]
---
<section id ="Skills">
    {skills.map(skill => <Skill skill={skill} />)}
</section>